# Database Configuration - Supabase PostgreSQL
# Copy this file to .env and fill in your actual values

# Full connection string (get from Supabase Dashboard > Settings > Database)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@[PROJECT-REF].supabase.co:5432/postgres

# Individual connection parameters
DB_HOST=[PROJECT-REF].supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=[YOUR-PASSWORD]
DB_SSL=true

# Scheduler Configuration
# Generate a secure random string for the API key
SCHEDULER_API_KEY=your-secure-random-api-key-here

# Application Configuration
NODE_ENV=development
PORT=3000

# Instructions:
# 1. Copy this file to .env
# 2. Replace [YOUR-PASSWORD] with your Supabase database password
# 3. Replace [PROJECT-REF] with your Supabase project reference (e.g., abcdefghijklmnop)
# 4. Generate a secure random string for SCHEDULER_API_KEY
# 5. Never commit the .env file to version control
